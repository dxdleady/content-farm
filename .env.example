# (cast) carousel generator — environment.
# Copy this file to .env and fill in the keys. .env is git-ignored.
# Loaded via process.loadEnvFile() from the project root.

# ── Image generation ────────────────────────────────────────────────────────
# WaveSpeed hosts the image-to-image / edit models. This is the key the main
# background stage uses (src/providers.mjs). https://wavespeed.ai
WAVESPEED_API_KEY=

# Google AI Studio key — text-to-image fallback ("nano banana", src/bgen.mjs).
# Without it the background stage is OFF and slides fall back to CSS gradients.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.

# ── Optional overrides ──────────────────────────────────────────────────────
# Chrome binary used for rendering (default: the macOS Google Chrome path).
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Model selection
# BANANA_MODEL=gemini-2.5-flash-image   # text-to-image model (src/bgen.mjs)
# EDIT_MODEL=qwen-edit                  # image-to-image model (see MODELS in src/providers.mjs)
# PACK_MODEL=                           # override for tools/pack-from-ref.mjs

# Concurrency
# CONCURRENCY=                          # image generation workers
# PACK_CONCURRENCY=                     # tools/pack-from-ref.mjs
# BAKE_CONCURRENCY=4                    # tools/model-bakeoff.mjs

# Per-tool knobs
# RUN_ID=                               # names the out/runs/<id>/ folder
# CARD=                                 # tools/layout-catalogue.mjs — render one card
# CARD_GROUND=#EEFF04                   # tools/card-catalogue.mjs
# CARD_INK=#0A0A0A                      # tools/card-catalogue.mjs
# REF_SAMPLE=5                          # src/bgen.mjs — ref sampling
