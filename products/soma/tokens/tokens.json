{
  "$meta": {
    "name": "SOMA — design tokens",
    "sources": {
      "landing": "soma-landing repo — src/components/landing/kinetic/kinetic.css (dark Kinetic v7) + landing.css (light vapor theme)",
      "brandAssets": "~/Downloads/Website Brand Assets 2 (wordmark, app icon)"
    },
    "extractedAt": "2026-08-24",
    "note": "Accents merge the two shipped themes: the Kinetic periwinkle/indigo/mint family and the vapor sky/terracotta/clay family. Newsreader + Manrope are the final brand faces (Google/OFL), self-hosted in products/soma/fonts."
  },

  "color": {
    "accent": {
      "sky":        "#3e6a8c",
      "terracotta": "#c97f55",
      "mint":       "#8fd3b4",
      "indigo":     "#5a7df5",
      "clay":       "#a3402f",
      "periwinkle": "#8faef8",
      "sage":       "#7ea88f",
      "skydeep":    "#2b4a63",
      "mist":       "#c6d6fd"
    },
    "text": {
      "main":     "#f3f4fa",
      "second":   "#FFFFFFAD",
      "inverse":  "#e2e5e7",
      "dark":     "#101315",
      "light":    "#e2e5e7"
    },
    "background": {
      "dark":    "#0c0a16",
      "light":   "#f6f7f7",
      "light2":  "#edeff0",
      "white":   "#FFFFFF",
      "surface": "#14121d"
    },
    "alpha": {
      "black": { "10":"#0000001A","20":"#00000033","30":"#0000004D","40":"#00000066","50":"#00000080","60":"#00000099","70":"#000000B2","80":"#000000CC","90":"#000000E5" },
      "white": { "10":"#FFFFFF1A","20":"#FFFFFF33","30":"#FFFFFF4D","40":"#FFFFFF66","50":"#FFFFFF80","60":"#FFFFFF99","70":"#FFFFFFB2","80":"#FFFFFFCC","90":"#FFFFFFE5" }
    },
    "misc": {
      "transparency":   "#0000004D",
      "transparency2":  "#D9D9D966",
      "hoverLogoOverlay": "#0000001A"
    }
  },

  "gradient": {
    "orb":      { "angle": 135, "stops": ["#eaf1f7", "#8faef8"] },
    "dusk":     { "angle": 135, "stops": ["#5a7df5", "#0c0a16"] },
    "dawn":     { "angle": 135, "stops": ["#c97f55", "#c6d6fd"] },
    "mistmint": { "angle": 135, "stops": ["#c6d6fd", "#8fd3b4"] }
  },

  "font": {
    "display": "Newsreader, \"Iowan Old Style\", Georgia, serif",
    "ui":      "Manrope, -apple-system, \"Helvetica Neue\", sans-serif"
  },

  "typography": {
    "display": {
      "superHero":    { "family":"display","size":92,"weight":400,"lineHeight":1.0,"letterSpacing":-2 },
      "hero":         { "family":"display","size":72,"weight":400,"lineHeight":1.0,"letterSpacing":-2 },
      "heroMob":      { "family":"display","size":48,"weight":400,"lineHeight":1.0,"letterSpacing":-2 },
      "superHeroMob": { "family":"display","size":32,"weight":400,"lineHeight":1.0,"letterSpacing":0 },
      "feature":      { "family":"display","size":40,"weight":400,"lineHeight":1.0,"letterSpacing":0 },
      "small":        { "family":"display","size":28,"weight":400,"lineHeight":1.0,"letterSpacing":0 },
      "smallMob":     { "family":"display","size":24,"weight":400,"lineHeight":1.0,"letterSpacing":0 }
    },
    "heading": {
      "h1":     { "family":"ui","size":48,"weight":500,"lineHeight":1.1,"letterSpacing":-1 },
      "h2":     { "family":"ui","size":32,"weight":500,"lineHeight":1.2,"letterSpacing":0 },
      "h2Mob":  { "family":"ui","size":24,"weight":500,"lineHeight":1.0,"letterSpacing":0 },
      "h3":     { "family":"ui","size":22,"weight":500,"lineHeight":1.0,"letterSpacing":0 },
      "h3Mob":  { "family":"ui","size":15,"weight":600,"lineHeight":1.0,"letterSpacing":0 },
      "h4":     { "family":"ui","size":18,"weight":600,"lineHeight":1.0,"letterSpacing":0 }
    },
    "body": {
      "extra":    { "family":"ui","size":40,"weight":300,"lineHeight":1.25,"letterSpacing":-1 },
      "extraMob": { "family":"ui","size":26,"weight":400,"lineHeight":1.6,"letterSpacing":0 },
      "super":    { "family":"ui","size":18,"weight":400,"lineHeight":1.6,"letterSpacing":0 },
      "large":    { "family":"ui","size":16,"weight":400,"lineHeight":1.6,"letterSpacing":0 },
      "base":     { "family":"ui","size":14,"weight":400,"lineHeight":1.5,"letterSpacing":0 },
      "small":    { "family":"ui","size":12,"weight":400,"lineHeight":1.0,"letterSpacing":0 }
    },
    "ui": {
      "bigButton":   { "family":"ui","size":18,"weight":600,"lineHeight":1.0,"letterSpacing":0 },
      "button":      { "family":"ui","size":16,"weight":600,"lineHeight":1.0,"letterSpacing":0 },
      "smallButton": { "family":"ui","size":14,"weight":600,"lineHeight":1.0,"letterSpacing":0 },
      "label":       { "family":"ui","size":12,"weight":600,"lineHeight":1.0,"letterSpacing":-1 },
      "titleCaps":   { "family":"ui","size":10,"weight":700,"lineHeight":1.0,"letterSpacing":10,"transform":"uppercase" }
    }
  },

  "radius": { "pill": 999, "card": 24, "badge": 13, "sm": 8 },
  "spacing": { "xs": 8, "sm": 16, "md": 24, "lg": 40, "xl": 64, "2xl": 80 }
}
